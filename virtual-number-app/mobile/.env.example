# Backend URL reachable from your phone (use your computer's LAN IP, not localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Subscriptions (RevenueCat > Project settings > API keys > public app-specific keys).
# Leave empty to build without in-app purchases.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Shown on the paywall; both stores require them for subscriptions
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy

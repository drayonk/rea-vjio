# HTTP
PORT=4000
# Public HTTPS URL the carrier uses to reach webhooks (e.g. an ngrok tunnel in dev)
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Long random string used to sign session tokens
AUTH_SECRET=change-me-to-a-long-random-string
# SQLite file
DATABASE_PATH=./secondline.db

# Telephony provider: "mock" (local dev, no real numbers) or "twilio"
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Subscriptions: "none" (paywall off, every user gets the Pro plan) or "revenuecat"
BILLING_PROVIDER=none
# RevenueCat > Project settings > API keys > Secret API key (v1)
REVENUECAT_SECRET_KEY=
# Any long random string; paste the same value into RevenueCat > Integrations >
# Webhooks > Authorization header as "Bearer <value>"
REVENUECAT_WEBHOOK_SECRET=
# Days after a subscription lapses before its numbers are released
LAPSED_RELEASE_DAYS=7
